msgstr "Cards lado a lado em telas largas. Telas estreitas usam menos."

#: admin/settings/class-ecsa-settings-page.php:3747
msgid "Card size"
msgstr "Tamanho do card"

#: admin/settings/class-ecsa-settings-page.php:3748
msgid "Scales text and spacing inside each card."
msgstr "Dimensiona o texto e o espaçamento dentro de cada card."

#: admin/settings/class-ecsa-settings-page.php:3751
msgid "Items to show inside card"
